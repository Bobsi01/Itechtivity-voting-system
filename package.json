{
  "name": "itech-2027-voting",
  "version": "1.0.52",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdf-viewer.mjs && next dev",
    "build": "node scripts/prepare-pdf-viewer.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate && node scripts/prepare-pdf-viewer.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "npm run test:crypto && npm run test:pdf && npm run test:e2e:flow",
    "test:crypto": "tsx src/lib/crypto/test-tokens.ts",
    "test:pdf": "tsx src/lib/pdf/test-geometry.ts",
    "test:e2e:flow": "tsx src/lib/pdf/test-e2e-flow.ts",
    "test:e2e:browser": "tsx src/lib/test/multi-agent-qa-suite.ts",
    "test:audit": "tsx src/lib/test/audit-regressions.ts",
    "test:ws": "tsx src/lib/test/test-websocket-integration.ts",
    "test:registration-gate": "tsx src/lib/test/test-registration-lifecycle-gate.ts",
    "deploy:functions": "node scripts/deploy-appwrite-functions.mjs",
    "deploy:site": "node scripts/deploy-appwrite-site.mjs",
    "test:smoke": "node scripts/test-deployed-site.mjs",
    "test:deployed": "node scripts/test-deployed-site.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "appwrite": "^29.3.1",
    "bcryptjs": "^3.0.3",
    "html5-qrcode": "^2.3.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "node-appwrite": "^31.3.0",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "braces": "3.0.3",
    "deepmerge-ts": "8.0.2",
    "postcss-selector-parser": "7.1.6"
  }
}

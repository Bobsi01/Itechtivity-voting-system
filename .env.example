# Application
NODE_ENV=development
PORT=3000
EVENT_HMAC_SECRET=your_event_hmac_secret_min_32_chars
NEXTAUTH_SECRET=your_nextauth_jwt_secret_min_32_chars
NEXTAUTH_URL=http://localhost:3000

# Database (Supabase PostgreSQL Pooler & Direct URL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Appwrite Cloud
APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="itechtivity-2027"
APPWRITE_API_KEY="your_appwrite_server_api_key"
APPWRITE_STORAGE_BUCKET_ID="bingo-cards-pdf"
APPWRITE_DATABASE_ID="itech2027-db"
APPWRITE_VOTES_COLLECTION_ID="votes"
APPWRITE_PDF_BATCHES_COLLECTION_ID="pdf_batches"
APPWRITE_LEADERBOARD_COLLECTION_ID="leaderboard_cache"
APPWRITE_FUNCTION_ID="generate-bingo-pdf"

NEXT_PUBLIC_APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="itechtivity-2027"
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID="bingo-cards-pdf"
NEXT_PUBLIC_APPWRITE_DATABASE_ID="itech2027-db"
NEXT_PUBLIC_APPWRITE_VOTES_COLLECTION_ID="votes"
NEXT_PUBLIC_APPWRITE_PDF_BATCHES_COLLECTION_ID="pdf_batches"

# App Settings
MAX_AWARDS=6
CARDS_PER_A4_SHEET=4
DEFAULT_SHEET_MARGIN_INCHES=0.3
